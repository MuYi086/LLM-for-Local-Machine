{
  "schema_version": 1,
  "workers": {
    "llm-local.sheetsage2.worker.v1": {
      "project": "model-audio/SheetSage2",
      "script": "worker.py",
      "output_kind": "file_ref",
      "output_argument": "--output-zip",
      "output_suffix": ".zip",
      "timeout_seconds": 1800,
      "environment": {
        "HF_HOME": "${HF_MIRROR_DIR}",
        "HF_MODULES_CACHE": "${RUNTIME_CACHE_DIR}/sheetsage2_hf_modules",
        "NUMBA_CACHE_DIR": "${RUNTIME_CACHE_DIR}/numba",
        "MPLCONFIGDIR": "${RUNTIME_CACHE_DIR}/matplotlib",
        "XDG_CACHE_HOME": "${RUNTIME_CACHE_DIR}/xdg"
      }
    },
    "llm-local.mert-v2-fullsong.worker.v1": {
      "project": "model-audio/MERT-v2-FullSong",
      "script": "worker.py",
      "output_kind": "file_ref",
      "output_argument": "--output-file",
      "output_suffix_field": "output",
      "output_suffixes": {
        "embedding": ".json",
        "frames": ".npz"
      },
      "timeout_seconds": 900,
      "environment": {
        "HF_HOME": "${HF_MIRROR_DIR}",
        "HF_MODULES_CACHE": "${RUNTIME_CACHE_DIR}/mert_v2_hf_modules"
      }
    },
    "llm-local.yue2-vae.worker.v1": {
      "project": "model-audio/YuE2-Vae",
      "script": "worker.py",
      "output_kind": "file_ref",
      "output_argument": "--output-file",
      "output_suffix_field": "operation",
      "output_suffixes": {
        "decode": ".wav",
        "encode": ".npy"
      },
      "timeout_seconds": 900,
      "environment": {
        "HF_HOME": "${HF_MIRROR_DIR}",
        "HF_MODULES_CACHE": "${RUNTIME_CACHE_DIR}/hf_modules"
      }
    },
    "llm-local.yue2-3b.worker.v1": {
      "project": "model-audio/YuE2-3B",
      "script": "worker.py",
      "output_kind": "file_ref",
      "output_argument": "--output-wav",
      "output_suffix": ".wav",
      "timeout_seconds": 1800,
      "environment": {
        "HF_HOME": "${HF_MIRROR_DIR}",
        "HF_MODULES_CACHE": "${RUNTIME_CACHE_DIR}/hf_modules",
        "TORCHINDUCTOR_CACHE_DIR": "${RUNTIME_CACHE_DIR}/torchinductor"
      }
    },
    "llm-local.tiger-dnr.worker.v1": {
      "project": "model-audio/TIGER-DnR",
      "script": "worker.py",
      "output_kind": "file_ref",
      "output_argument": "--output-zip",
      "output_suffix": ".zip",
      "timeout_seconds": 900,
      "environment": {
        "HF_HOME": "${HF_MIRROR_DIR}",
        "HF_MODULES_CACHE": "${RUNTIME_CACHE_DIR}/tiger_dnr_hf_modules"
      }
    }
  }
}
