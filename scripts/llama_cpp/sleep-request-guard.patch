+void server_queue::acquire_model_request() {
+    // Reserve before waking: no gap may allow idle unload after wakeup.
+    {
+        std::unique_lock<std::mutex> lock(mutex_tasks);
+        ++active_model_requests;
+    }
+    try {
+        wait_until_no_sleep();
+    } catch (...) {
+        release_model_request();
+        throw;
+    }
+}
+
+void server_queue::release_model_request() {
+    std::unique_lock<std::mutex> lock(mutex_tasks);
+    GGML_ASSERT(active_model_requests > 0);
+    if (--active_model_requests == 0) {
+        time_last_task = ggml_time_ms();
+        condition_tasks.notify_all();
+    }
+}
