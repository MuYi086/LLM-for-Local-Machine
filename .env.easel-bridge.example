# 复制为 .env.easel-bridge，并替换成 `python3 -c 'import secrets; print(secrets.token_urlsafe(32))'` 的输出。
EASEL_BRIDGE_API_KEY=replace-with-a-random-secret
# 默认由 start.sh 跟随模型 API 端口；只在需要显式覆盖上游地址时取消注释。
# EASEL_BRIDGE_CHAT_URL=http://127.0.0.1:8401/v1/AtomicChat/Ornith-1.5-35B-A3B-AD-Q5
# EASEL_BRIDGE_MOSS_URL=http://127.0.0.1:8501/v1/openmoss/MOSS-Image-SFT-Q8_0
# EASEL_BRIDGE_VOXCPM_URL=http://127.0.0.1:8313/v1/OpenBMB/VoxCPM2-GGUF
EASEL_BRIDGE_TIMEOUT=900
EASEL_BRIDGE_MAX_REQUEST_BYTES=12582912
EASEL_BRIDGE_MAX_RESPONSE_BYTES=67108864
EASEL_BRIDGE_FFMPEG_BIN=ffmpeg
EASEL_BRIDGE_FFMPEG_TIMEOUT=120
